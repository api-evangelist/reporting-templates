{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "reporting": "https://api-evangelist.github.io/reporting-templates/vocab#",

    "ReportTemplate": {
      "@id": "reporting:ReportTemplate",
      "@type": "schema:CreativeWork"
    },
    "Dashboard": {
      "@id": "reporting:Dashboard",
      "@type": "schema:WebPage"
    },
    "DataVisualization": {
      "@id": "reporting:DataVisualization",
      "@type": "schema:CreativeWork"
    },
    "Metric": {
      "@id": "reporting:Metric",
      "@type": "schema:Observation"
    },
    "KPI": {
      "@id": "reporting:KPI",
      "@type": "schema:Observation"
    },

    "name": {
      "@id": "schema:name"
    },
    "description": {
      "@id": "schema:description"
    },
    "category": {
      "@id": "schema:category"
    },
    "format": {
      "@id": "schema:encodingFormat"
    },
    "author": {
      "@id": "schema:author"
    },
    "dateCreated": {
      "@id": "schema:dateCreated",
      "@type": "xsd:dateTime"
    },
    "dateModified": {
      "@id": "schema:dateModified",
      "@type": "xsd:dateTime"
    },
    "keywords": {
      "@id": "schema:keywords"
    },
    "audience": {
      "@id": "schema:audience"
    },
    "platform": {
      "@id": "schema:softwareApplication"
    },
    "metricName": {
      "@id": "reporting:metricName"
    },
    "metricValue": {
      "@id": "reporting:metricValue"
    },
    "frequency": {
      "@id": "reporting:frequency"
    },
    "dataSource": {
      "@id": "schema:isBasedOn"
    },
    "visualizationType": {
      "@id": "reporting:visualizationType"
    },
    "timePeriod": {
      "@id": "schema:temporalCoverage"
    }
  }
}
